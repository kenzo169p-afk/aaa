# =============================================================================
# Variáveis de Ambiente — Hostinger VPS (.env)
# Copie este arquivo para .env na VPS: cp .env.example .env
# =============================================================================

# Porta interna do servidor Python (Nginx faz o proxy da porta 80/443 para 8090)
PORT=8090

# Caminho do banco de dados SQLite Multi-Tenant persistente
SAAS_DB_PATH=/var/lib/saas-contabil/saas_contabil.db

# Chave secreta para assinatura de Tokens JWT (Troque em produção!)
SAAS_JWT_SECRET=troque-esta-chave-secreta-em-producao-hostinger-vps-2026

# (Opcional) Integração com Supabase PostgreSQL Multi-Tenant (RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# (Opcional) Domínio principal configurado na Hostinger VPS
APP_DOMAIN=
